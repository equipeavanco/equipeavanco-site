---
import { reviews, googleReviewsUrl } from '../data/site';

// Avatar: inicial + cor da marca alternada
const colors = ['bg-navy-600', 'bg-magenta-500', 'bg-navy-500', 'bg-magenta-600'];
function stars(n: number) {
  return Array.from({ length: 5 }, (_, i) => i < n);
}
---
<section class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-semibold uppercase tracking-wider text-magenta-500">Depoimentos</span>
      <h2 class="mt-3 text-3xl font-extrabold text-navy-800 sm:text-4xl">O que dizem sobre a Avanço</h2>
      <div class="mt-4 flex items-center justify-center gap-2 text-navy-500">
        <!-- Google G -->
        <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
          <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.7v3h3.9c2.3-2.1 3.5-5.2 3.5-8.9Z"/>
          <path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.8-5H1.2v3.1A12 12 0 0 0 12 24Z"/>
          <path fill="#FBBC05" d="M5.2 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.2a12 12 0 0 0 0 10.8l4-3.1Z"/>
          <path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.2 6.6l4 3.1C6.2 6.9 8.9 4.8 12 4.8Z"/>
        </svg>
        <span class="text-sm font-medium">Avaliações reais de clientes no Google</span>
      </div>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {reviews.map((r, i) => (
        <figure class="flex flex-col rounded-2xl border border-navy-100 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-1 text-amber-400" aria-label={`${r.rating} de 5 estrelas`}>
            {stars(r.rating).map((on) => (
              <svg viewBox="0 0 20 20" class={`h-4 w-4 ${on ? 'fill-current' : 'fill-navy-100'}`} aria-hidden="true">
                <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 15l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5Z"/>
              </svg>
            ))}
          </div>
          <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-navy-600">“{r.text}”</blockquote>
          <figcaption class="mt-5 flex items-center gap-3 border-t border-navy-100 pt-4">
            <span class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white ${colors[i % colors.length]}`}>
              {r.name.charAt(0)}
            </span>
            <span>
              <span class="block text-sm font-semibold text-navy-800">{r.name}</span>
              <span class="block text-xs text-navy-400">{r.when}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>

    {googleReviewsUrl && (
      <div class="mt-10 text-center">
        <a
          href={googleReviewsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border-2 border-navy-200 px-6 py-3 text-sm font-semibold text-navy-700 transition-colors hover:border-navy-600 hover:bg-navy-50"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
            <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.7v3h3.9c2.3-2.1 3.5-5.2 3.5-8.9Z"/>
            <path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.8-5H1.2v3.1A12 12 0 0 0 12 24Z"/>
            <path fill="#FBBC05" d="M5.2 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.2a12 12 0 0 0 0 10.8l4-3.1Z"/>
            <path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.2 6.6l4 3.1C6.2 6.9 8.9 4.8 12 4.8Z"/>
          </svg>
          Ver todas as avaliações no Google
        </a>
      </div>
    )}
  </div>
</section>
