---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { portfolioImages } from '../data/portfolioImages';
import type { PortfolioEvent } from '../data/site';

interface Props {
  event: PortfolioEvent;
}
const { event } = Astro.props;
const img = portfolioImages[event.image];
---
<article class="group flex flex-col overflow-hidden rounded-2xl border border-navy-100 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-magenta-200 hover:shadow-xl hover:shadow-navy-900/5">
  <div class="relative aspect-[16/10] overflow-hidden bg-navy-100">
    {img && (
      <Image
        src={img}
        alt={event.title}
        widths={[400, 640, 900]}
        sizes="(max-width: 768px) 100vw, 45vw"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-navy-900/15 to-transparent"></div>
  </div>

  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <h3 class="text-xl font-extrabold uppercase tracking-tight text-navy-700">{event.title}</h3>
    <p class="mt-2 text-sm leading-relaxed text-navy-500">{event.subtitle}</p>

    {event.intro && <p class="mt-4 text-sm font-semibold text-navy-700">{event.intro}</p>}

    <ul class="mt-3 space-y-2 text-sm text-navy-700">
      {event.items.map((item) => (
        <li class="flex items-start gap-2.5">
          <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-magenta-50 text-magenta-500">
            <Icon name="check" class="h-3.5 w-3.5" />
          </span>
          <span>{item}</span>
        </li>
      ))}
    </ul>

    {event.note && (
      <p class="mt-5 border-t border-navy-100 pt-4 text-sm italic text-navy-500">{event.note}</p>
    )}
  </div>
</article>
