---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
}
const { eyebrow, title, subtitle } = Astro.props;
---
<section class="relative overflow-hidden bg-brand-gradient text-white">
  <div class="absolute inset-0 opacity-[0.07]" aria-hidden="true"
    style="background-image: repeating-linear-gradient(-45deg, #fff 0 2px, transparent 2px 22px)"></div>
  <div class="band-refletiva absolute inset-x-0 bottom-0" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    {eyebrow && (
      <span class="eyebrow eyebrow-light">{eyebrow}</span>
    )}
    <h1 class="mt-3 text-5xl font-extrabold sm:text-6xl lg:text-7xl">{title}</h1>
    {subtitle && <p class="mt-4 max-w-2xl text-lg text-navy-100">{subtitle}</p>}
  </div>
</section>
