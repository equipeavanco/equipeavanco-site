---
import Icon from './Icon.astro';
import { href } from '../data/site';
import { local, dataBR, type Post } from '../data/blog';
interface Props { post: Post }
const { post } = Astro.props;
---
<a href={href(`/blog/${post.slug}`)}
  class="group flex flex-col overflow-hidden rounded-2xl bg-white shadow-md transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
  <div class="relative aspect-[16/10] overflow-hidden bg-navy-100">
    {post.cover && (
      <img src={local(post.cover)} alt={post.coverAlt || post.title} loading="lazy"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
    )}
    <span class="absolute inset-x-0 top-0 h-1.5 bg-magenta-500" aria-hidden="true"></span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="font-display text-sm font-bold uppercase tracking-wider text-magenta-500">
      {dataBR(post.date)}{post.minutes ? ` · ${post.minutes} min de leitura` : ''}
    </p>
    <h3 class="mt-2 text-2xl font-bold uppercase leading-tight text-navy-800">{post.title}</h3>
    {post.description && <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-navy-600">{post.description}</p>}
    <span class="mt-auto inline-flex items-center gap-1.5 pt-5 font-display text-base font-bold uppercase tracking-wide text-navy-700 group-hover:text-magenta-600">
      Ler artigo <Icon name="arrow" class="h-4 w-4" />
    </span>
  </div>
</a>
