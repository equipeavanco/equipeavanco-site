---
import Icon from './Icon.astro';
import type { Service } from '../data/site';

interface Props {
  service: Service;
  detailed?: boolean;
}
const { service, detailed = false } = Astro.props;
---
<article
  id={service.slug}
  class="group relative flex flex-col rounded-2xl border border-navy-100 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-magenta-200 hover:shadow-xl hover:shadow-navy-900/5 scroll-mt-24"
>
  <div class="mb-5 inline-flex h-14 w-14 items-center justify-center rounded-xl bg-navy-50 text-navy-600 transition-colors group-hover:bg-magenta-500 group-hover:text-white">
    <Icon name={service.icon} class="h-7 w-7" />
  </div>
  <h3 class="text-xl font-bold text-navy-800">{service.title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-navy-500">{service.summary}</p>

  {(detailed || true) && (
    <ul class="mt-5 space-y-2.5 text-sm text-navy-700">
      {service.items.map((item) => (
        <li class="flex items-start gap-2.5">
          <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-magenta-50 text-magenta-500">
            <Icon name="check" class="h-3.5 w-3.5" />
          </span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  )}
</article>
