---
import { Image } from 'astro:assets';
import logo from '../assets/logo-transparent.png';
import { nav, href, contact } from '../data/site';
import Icon from './Icon.astro';
import Button from './Button.astro';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
function isActive(path: string) {
  const target = href(path).replace(/\/$/, '') || '/';
  return target === current || (path === '/' && (current === base || current === ''));
}
const wa = `https://wa.me/${contact.primaryWhatsapp}?text=${encodeURIComponent(contact.whatsappMessage)}`;
---
<header
  id="site-header"
  class="sticky top-0 z-50 w-full border-b border-navy-100/70 bg-white/90 backdrop-blur-md transition-shadow"
>
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href={href('/')} class="flex shrink-0 items-center" aria-label="Equipe Avanço — página inicial">
      <Image src={logo} alt="Equipe Avanço" class="h-10 w-auto sm:h-11" loading="eager" />
    </a>

    <!-- Menu desktop -->
    <ul class="hidden items-center gap-1 lg:flex">
      {nav.map((item) => (
        <li>
          <a
            href={href(item.href)}
            class:list={[
              'rounded-full px-4 py-2 text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'text-magenta-600'
                : 'text-navy-800 hover:text-magenta-600 hover:bg-navy-50',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="hidden lg:block">
      <Button href={wa} target="_blank" size="md">
        <Icon name="whatsapp" class="h-4 w-4" />
        Orçamento rápido
      </Button>
    </div>

    <!-- Botão menu mobile -->
    <button
      id="menu-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-lg p-2 text-navy-700 hover:bg-navy-50 lg:hidden"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" class="h-6 w-6" />
    </button>
  </nav>

  <!-- Menu mobile -->
  <div id="mobile-menu" class="hidden border-t border-navy-100 bg-white lg:hidden">
    <ul class="space-y-1 px-4 py-4">
      {nav.map((item) => (
        <li>
          <a
            href={href(item.href)}
            class:list={[
              'block rounded-lg px-4 py-2.5 text-base font-medium transition-colors',
              isActive(item.href)
                ? 'bg-magenta-50 text-magenta-600'
                : 'text-navy-800 hover:bg-navy-50',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <Button href={wa} target="_blank" class="w-full">
          <Icon name="whatsapp" class="h-4 w-4" />
          Orçamento rápido
        </Button>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const header = document.getElementById('site-header');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      })
    );
  }
  // sombra ao rolar
  if (header) {
    const onScroll = () =>
      header.classList.toggle('shadow-md', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
