---
// Fotos reais da equipe em serviço (sem imagens de IA).
// Para trocar: substitua os arquivos em src/assets/servicos/ e ajuste a lista abaixo.
import { Image } from 'astro:assets';
import atendimento from '../assets/servicos/16f629cc-image.png';
import equipe from '../assets/servicos/a3b5b513-image.png';
import montagem from '../assets/servicos/2f0cc05a-image.png';

const photos = [
  { src: atendimento, alt: 'Bombeiros civis da Equipe Avanço aferindo a pressão de um trabalhador durante a montagem de um evento', caption: 'Atendimento em campo' },
  { src: equipe, alt: 'Duas bombeiras civis da Equipe Avanço uniformizadas em um evento', caption: 'Equipe uniformizada e preparada' },
  { src: montagem, alt: 'Bombeira civil da Equipe Avanço acompanhando a montagem da estrutura de um palco', caption: 'Prevenção desde a montagem', pos: 'object-[50%_85%]' },
];
---
<div class="grid gap-4 sm:grid-cols-3 sm:gap-6">
  {photos.map((p) => (
    <figure class="group relative overflow-hidden rounded-2xl bg-navy-100 shadow-sm">
      <Image
        src={p.src}
        alt={p.alt}
        widths={[400, 640, 900]}
        sizes="(max-width: 640px) 100vw, 33vw"
        class:list={['aspect-[4/5] h-full w-full object-cover transition-transform duration-500 group-hover:scale-105', p.pos]}
      />
      <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-navy-900/85 via-navy-900/40 to-transparent px-5 pb-4 pt-12 text-sm font-semibold text-white">
        {p.caption}
      </figcaption>
    </figure>
  ))}
</div>
