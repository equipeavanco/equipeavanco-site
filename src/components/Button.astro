---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'white';
  size?: 'md' | 'lg';
  class?: string;
  target?: string;
  rel?: string;
}
const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  target,
  rel,
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-all duration-200 focus:outline-none focus-visible:ring-4 focus-visible:ring-magenta-300/50';
const sizes = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3.5 text-base',
};
const variants = {
  primary: 'bg-magenta-500 text-white hover:bg-magenta-600 shadow-lg shadow-magenta-500/25 hover:-translate-y-0.5',
  secondary: 'bg-navy-600 text-white hover:bg-navy-700 shadow-lg shadow-navy-600/20 hover:-translate-y-0.5',
  outline: 'border-2 border-navy-600 text-navy-700 hover:bg-navy-600 hover:text-white',
  white: 'bg-white text-navy-700 hover:bg-navy-50 shadow-lg hover:-translate-y-0.5',
};
---
<a
  href={href}
  target={target}
  rel={rel ?? (target === '_blank' ? 'noopener noreferrer' : undefined)}
  class={`${base} ${sizes[size]} ${variants[variant]} ${className}`}
>
  <slot />
</a>
