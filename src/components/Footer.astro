---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site, contact, nav, href } from '../data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const wa = `https://wa.me/${contact.primaryWhatsapp}?text=${encodeURIComponent(contact.whatsappMessage)}`;
---
<footer class="bg-navy-800 text-navy-100">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <!-- Marca -->
      <div class="lg:col-span-1">
        <div class="inline-flex rounded-xl bg-white p-3">
          <Image src={logo} alt="Equipe Avanço" class="h-12 w-auto" loading="eager" />
        </div>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-navy-200">
          {site.descriptor}. {contact.region}.
        </p>
        <div class="mt-5 flex gap-3">
          <a href={contact.social.instagram} target="_blank" rel="noopener noreferrer"
            class="rounded-full bg-navy-700 p-2.5 transition-colors hover:bg-magenta-500" aria-label="Instagram">
            <Icon name="instagram" class="h-5 w-5" />
          </a>
          <a href={contact.social.facebook} target="_blank" rel="noopener noreferrer"
            class="rounded-full bg-navy-700 p-2.5 transition-colors hover:bg-magenta-500" aria-label="Facebook">
            <Icon name="facebook" class="h-5 w-5" />
          </a>
          <a href={wa} target="_blank" rel="noopener noreferrer"
            class="rounded-full bg-navy-700 p-2.5 transition-colors hover:bg-magenta-500" aria-label="WhatsApp">
            <Icon name="whatsapp" class="h-5 w-5" />
          </a>
        </div>
      </div>

      <!-- Navegação -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">Navegação</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {nav.map((item) => (
            <li>
              <a href={href(item.href)} class="text-navy-200 transition-colors hover:text-white">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contato -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">Contato</h3>
        <ul class="mt-4 space-y-3 text-sm">
          {contact.emails.map((email) => (
            <li class="flex items-start gap-2.5">
              <Icon name="mail" class="mt-0.5 h-4 w-4 shrink-0 text-magenta-400" />
              <a href={`mailto:${email}`} class="break-all text-navy-200 transition-colors hover:text-white">
                {email}
              </a>
            </li>
          ))}
          {contact.phones.map((p) => (
            <li class="flex items-start gap-2.5">
              <Icon name="phone" class="mt-0.5 h-4 w-4 shrink-0 text-magenta-400" />
              <a href={`https://wa.me/${p.whatsapp}`} target="_blank" rel="noopener noreferrer"
                class="text-navy-200 transition-colors hover:text-white">
                {p.number} <span class="text-navy-300">· {p.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Atuação -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">Atuação</h3>
        <p class="mt-4 flex items-start gap-2.5 text-sm text-navy-200">
          <Icon name="pin" class="mt-0.5 h-4 w-4 shrink-0 text-magenta-400" />
          {contact.region}
        </p>
        <p class="mt-3 text-sm text-navy-200">
          Empresa fundada em {site.foundedYear}, com expertise em emergências médicas e perícia técnica.
        </p>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-3 border-t border-navy-700 pt-6 text-xs text-navy-300 sm:flex-row">
      <p>© {year} {site.legalName}. Todos os direitos reservados.</p>
      <p>{site.descriptor}.</p>
    </div>
  </div>
</footer>
