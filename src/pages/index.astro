---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import Reviews from '../components/Reviews.astro';
import ServicePhotos from '../components/ServicePhotos.astro';
import { Image } from 'astro:assets';
import heroFoto from '../assets/servicos/16f629cc-image.png';
import { site, contact, services, differentiators, mvv, portfolio, href } from '../data/site';

const wa = `https://wa.me/${contact.primaryWhatsapp}?text=${encodeURIComponent(contact.whatsappMessage)}`;
const featured = portfolio.slice(0, 3);
const team = ['Bombeiros', 'Socorristas', 'Enfermeiros', 'Médicos', 'Fisioterapeutas', 'Engenheiros de segurança'];
---
<Layout>
  <!-- ================= HERO ================= -->
  <section class="relative overflow-hidden bg-brand-gradient text-white">
    <div class="absolute inset-0 opacity-[0.07]" aria-hidden="true"
      style="background-image: repeating-linear-gradient(-45deg, #fff 0 2px, transparent 2px 22px)"></div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 pb-24 pt-16 sm:px-6 sm:pt-20 lg:grid-cols-12 lg:px-8 lg:pb-28 lg:pt-24">
      <div class="animate-fade-up lg:col-span-7">
        <span class="eyebrow eyebrow-light">{site.descriptor}</span>
        <h1 class="mt-5 text-5xl font-extrabold sm:text-6xl lg:text-7xl">
          Você cuida do evento.<br />
          <span class="text-magenta-300">Nós cuidamos das pessoas.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-xl leading-relaxed text-navy-100">
          Assessoria preventiva e médica para <strong class="font-semibold text-white">shows, baladas,
          empresas, indústrias e eventos em geral</strong>, atuando em todo o Brasil, com um
          quadro de profissionais interdisciplinar:
        </p>
        <ul class="mt-6 flex max-w-2xl flex-wrap gap-2" aria-label="Nossa equipe">
          {team.map((t) => (
            <li class="rounded-md bg-white px-3 py-1.5 font-display text-base font-bold uppercase tracking-wide text-navy-700 shadow-md">{t}</li>
          ))}
        </ul>
        <p class="mt-7 flex max-w-2xl items-start gap-3 border-l-4 border-magenta-400 pl-4 font-display text-2xl font-bold uppercase leading-snug text-white">
          <span>Disponibilizamos tudo o que é necessário para a segurança do seu ambiente,
          <span class="text-magenta-300">em todo o Brasil</span>.</span>
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <Button href={wa} target="_blank" variant="primary" size="lg">
            <Icon name="whatsapp" class="h-5 w-5" />
            Solicitar orçamento
          </Button>
          <Button href={href('/servicos')} variant="white" size="lg">
            Conhecer serviços
            <Icon name="arrow" class="h-5 w-5" />
          </Button>
        </div>
      </div>

      <div class="relative hidden lg:col-span-5 lg:block">
        <div class="absolute -right-4 -top-4 h-full w-full rounded-2xl bg-magenta-500" aria-hidden="true"></div>
        <div class="relative overflow-hidden rounded-2xl shadow-2xl ring-4 ring-white">
          <Image src={heroFoto} alt="Bombeiros civis da Equipe Avanço prestando atendimento durante a montagem de um evento"
            widths={[480, 720, 960]} sizes="40vw" loading="eager"
            class="aspect-[4/5] w-full object-cover" />
        </div>
        <div class="absolute -bottom-6 -left-6 rounded-xl bg-white px-5 py-3 text-navy-800 shadow-xl">
          <span class="block font-display text-sm font-bold uppercase tracking-widest text-magenta-500">Desde</span>
          <span class="block font-display text-4xl font-extrabold leading-none">{site.foundedYear}</span>
        </div>
      </div>
    </div>
    <div class="band-refletiva absolute inset-x-0 bottom-0" aria-hidden="true"></div>
  </section>

  <!-- ================= DIFERENCIAIS ================= -->
  <section class="border-b border-navy-100 bg-navy-50/50">
    <div class="mx-auto grid max-w-7xl gap-6 px-4 py-12 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8">
      {differentiators.map((d) => (
        <div class="flex items-start gap-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-navy-600 text-white shadow-md">
            <Icon name={d.icon} class="h-6 w-6" />
          </div>
          <div>
            <h3 class="text-xl font-bold uppercase text-navy-800">{d.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-navy-500">{d.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ================= SERVIÇOS ================= -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow">Nossos serviços</span>
      <h2 class="mt-4 text-4xl font-extrabold text-navy-800 sm:text-5xl lg:text-6xl">
        Tudo para ambientes mais seguros
      </h2>
      <p class="mt-4 text-navy-500">
        Da emergência à prevenção, uma estrutura completa para proteger pessoas e cumprir a legislação.
      </p>
    </div>
    <div class="mt-12">
      <ServicePhotos />
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
  </section>

  <!-- ================= SOBRE (resumo) ================= -->
  <section class="bg-navy-50/50">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div>
        <span class="eyebrow">Quem somos</span>
        <h2 class="mt-4 text-4xl font-extrabold text-navy-800 sm:text-5xl lg:text-6xl">
          Experiência que salva e previne
        </h2>
        <p class="mt-5 leading-relaxed text-navy-600">
          Fundada em {site.foundedYear}, a Equipe Avanço é especializada em assessoria
          preventiva, médica e pericial, com foco em Segurança e Saúde Ocupacional.
          Atuamos com agilidade, padronização e alta performance para garantir
          ambientes mais seguros em todo o Brasil.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button href={href('/sobre')} variant="secondary">
            Nossa história
            <Icon name="arrow" class="h-5 w-5" />
          </Button>
          <Button href={href('/contato')} variant="outline">Fale conosco</Button>
        </div>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="rounded-2xl border-t-4 border-magenta-500 bg-white p-6 shadow-md">
          <Icon name="target" class="h-8 w-8 text-magenta-500" />
          <h3 class="mt-4 text-2xl font-bold uppercase text-navy-800">Missão</h3>
          <p class="mt-2 text-sm leading-relaxed text-navy-500">{mvv.mission}</p>
        </div>
        <div class="rounded-2xl border-t-4 border-magenta-500 bg-white p-6 shadow-md">
          <Icon name="bolt" class="h-8 w-8 text-magenta-500" />
          <h3 class="mt-4 text-2xl font-bold uppercase text-navy-800">Visão</h3>
          <p class="mt-2 text-sm leading-relaxed text-navy-500">{mvv.vision}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PORTFÓLIO ================= -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow">Portfólio de atendimento</span>
      <h2 class="mt-4 text-4xl font-extrabold text-navy-800 sm:text-5xl lg:text-6xl">
        Eventos que confiaram na Avanço
      </h2>
      <p class="mt-4 text-navy-500">
        Cobertura médica e de segurança em grandes eventos, com estrutura completa e operação técnica especializada.
      </p>
    </div>
    <div class="mt-14 grid gap-7 md:grid-cols-2 lg:grid-cols-3">
      {featured.map((event) => <PortfolioCard event={event} />)}
    </div>
    <div class="mt-10 text-center">
      <Button href={href('/portfolio')} variant="secondary" size="lg">
        Ver portfólio completo
        <Icon name="arrow" class="h-5 w-5" />
      </Button>
    </div>
  </section>

  <!-- ================= AVALIAÇÕES ================= -->
  <Reviews />

  <!-- ================= CTA ================= -->
  <section class="bg-brand-gradient">
    <div class="mx-auto max-w-5xl px-4 py-16 text-center text-white sm:px-6 lg:px-8">
      <h2 class="text-4xl font-extrabold sm:text-5xl">Precisa de cobertura ou assessoria?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-navy-100">
        Entre em contato agora mesmo e receba um orçamento rápido, sob medida para a sua necessidade.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button href={wa} target="_blank" variant="primary" size="lg">
          <Icon name="whatsapp" class="h-5 w-5" />
          Falar no WhatsApp
        </Button>
        <Button href={href('/contato')} variant="white" size="lg">Enviar mensagem</Button>
      </div>
    </div>
  </section>
</Layout>
