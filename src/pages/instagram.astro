---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import { instagram } from '../data/site';
---
<Layout
  title="Instagram"
  description="Acompanhe as postagens da Equipe Avanço: eventos, treinamentos e bastidores da equipe em operação."
>
  <PageHeader
    eyebrow="Instagram"
    title={`@${instagram.handle}`}
    subtitle="Eventos, treinamentos e bastidores da equipe em operação. As postagens do nosso Instagram aparecem aqui automaticamente."
  />
  <InstagramFeed max={24} showHeading={false} />
</Layout>
