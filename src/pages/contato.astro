---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { contact, site } from '../data/site';

const wa = `https://wa.me/${contact.primaryWhatsapp}?text=${encodeURIComponent(contact.whatsappMessage)}`;
const formAction = contact.formspreeId ? `https://formspree.io/f/${contact.formspreeId}` : '';
---
<Layout
  title="Contato"
  description="Fale com a Equipe Avanço: solicite um orçamento rápido por WhatsApp, e-mail ou pelo formulário. Atendimento em todo o Brasil."
>
  <PageHeader
    eyebrow="Contato"
    title="Fale com a Equipe Avanço"
    subtitle="Entre em contato agora mesmo e receba um orçamento rápido, sob medida para a sua necessidade."
  />

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-5">
      <!-- Infos de contato -->
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold text-navy-800">Canais de atendimento</h2>
        <p class="mt-3 text-navy-500">
          Escolha o canal que preferir. Respondemos o mais rápido possível.
        </p>

        <div class="mt-8 space-y-6">
          <div>
            <h3 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-magenta-500">
              <Icon name="whatsapp" class="h-5 w-5" /> WhatsApp
            </h3>
            <ul class="mt-3 space-y-2">
              {contact.phones.map((p) => (
                <li>
                  <a href={`https://wa.me/${p.whatsapp}`} target="_blank" rel="noopener noreferrer"
                    class="font-medium text-navy-700 transition-colors hover:text-magenta-600">
                    {p.number} <span class="font-normal text-navy-400">· {p.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h3 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-magenta-500">
              <Icon name="mail" class="h-5 w-5" /> E-mail
            </h3>
            <ul class="mt-3 space-y-2">
              {contact.emails.map((email) => (
                <li>
                  <a href={`mailto:${email}`} class="break-all font-medium text-navy-700 transition-colors hover:text-magenta-600">
                    {email}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h3 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-magenta-500">
              <Icon name="pin" class="h-5 w-5" /> Atuação
            </h3>
            <p class="mt-3 font-medium text-navy-700">{contact.region}</p>
          </div>

          <div class="flex gap-3 pt-2">
            <a href={contact.social.instagram} target="_blank" rel="noopener noreferrer"
              class="rounded-full bg-navy-50 p-3 text-navy-600 transition-colors hover:bg-magenta-500 hover:text-white" aria-label="Instagram">
              <Icon name="instagram" class="h-5 w-5" />
            </a>
            <a href={contact.social.facebook} target="_blank" rel="noopener noreferrer"
              class="rounded-full bg-navy-50 p-3 text-navy-600 transition-colors hover:bg-magenta-500 hover:text-white" aria-label="Facebook">
              <Icon name="facebook" class="h-5 w-5" />
            </a>
          </div>
        </div>
      </div>

      <!-- Formulário -->
      <div class="lg:col-span-3">
        <div class="rounded-2xl border border-navy-100 bg-white p-7 shadow-sm sm:p-9">
          <h2 class="text-2xl font-bold text-navy-800">Solicitar orçamento</h2>
          <p class="mt-2 text-sm text-navy-500">
            Preencha os campos abaixo. Também atendemos pelo WhatsApp
            <a href={wa} target="_blank" rel="noopener noreferrer" class="font-semibold text-magenta-600 hover:underline">clicando aqui</a>.
          </p>

          {formAction ? (
            <form id="contact-form" action={formAction} method="POST" class="mt-7 space-y-5">
              <input type="hidden" name="_subject" value={`Novo contato pelo site — ${site.name}`} />
              <!-- honeypot anti-spam -->
              <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="nome" class="block text-sm font-medium text-navy-700">Nome *</label>
                  <input id="nome" name="nome" type="text" required
                    class="mt-1.5 w-full rounded-lg border border-navy-200 px-4 py-2.5 text-navy-800 outline-none transition focus:border-magenta-400 focus:ring-2 focus:ring-magenta-200" />
                </div>
                <div>
                  <label for="telefone" class="block text-sm font-medium text-navy-700">Telefone / WhatsApp</label>
                  <input id="telefone" name="telefone" type="tel"
                    class="mt-1.5 w-full rounded-lg border border-navy-200 px-4 py-2.5 text-navy-800 outline-none transition focus:border-magenta-400 focus:ring-2 focus:ring-magenta-200" />
                </div>
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-navy-700">E-mail *</label>
                <input id="email" name="email" type="email" required
                  class="mt-1.5 w-full rounded-lg border border-navy-200 px-4 py-2.5 text-navy-800 outline-none transition focus:border-magenta-400 focus:ring-2 focus:ring-magenta-200" />
              </div>
              <div>
                <label for="assunto" class="block text-sm font-medium text-navy-700">Assunto</label>
                <select id="assunto" name="assunto"
                  class="mt-1.5 w-full rounded-lg border border-navy-200 bg-white px-4 py-2.5 text-navy-800 outline-none transition focus:border-magenta-400 focus:ring-2 focus:ring-magenta-200">
                  <option>Cobertura médica de eventos</option>
                  <option>Treinamentos e capacitações</option>
                  <option>Consultoria em SST</option>
                  <option>Assessoria pericial</option>
                  <option>Outro assunto</option>
                </select>
              </div>
              <div>
                <label for="mensagem" class="block text-sm font-medium text-navy-700">Mensagem *</label>
                <textarea id="mensagem" name="mensagem" rows="5" required
                  class="mt-1.5 w-full rounded-lg border border-navy-200 px-4 py-2.5 text-navy-800 outline-none transition focus:border-magenta-400 focus:ring-2 focus:ring-magenta-200"></textarea>
              </div>
              <button type="submit"
                class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-magenta-500 px-7 py-3.5 font-semibold text-white shadow-lg shadow-magenta-500/25 transition-all hover:-translate-y-0.5 hover:bg-magenta-600 sm:w-auto">
                <Icon name="mail" class="h-5 w-5" />
                Enviar mensagem
              </button>
              <p id="form-status" class="hidden text-sm"></p>
            </form>
          ) : (
            <div class="mt-7 rounded-xl border border-dashed border-navy-300 bg-navy-50 p-6 text-sm text-navy-600">
              <p class="font-semibold text-navy-800">⚙️ Formulário ainda não configurado</p>
              <p class="mt-2">
                Para ativar o envio, crie um formulário grátis no
                <a href="https://formspree.io" target="_blank" rel="noopener noreferrer" class="font-semibold text-magenta-600 hover:underline">Formspree</a>
                e cole o ID no arquivo <code class="rounded bg-white px-1.5 py-0.5">src/data/site.ts</code> (campo <code class="rounded bg-white px-1.5 py-0.5">formspreeId</code>).
              </p>
              <p class="mt-3">Enquanto isso, fale com a gente pelo
                <a href={wa} target="_blank" rel="noopener noreferrer" class="font-semibold text-magenta-600 hover:underline">WhatsApp</a>.
              </p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Envio via fetch para mostrar mensagem de sucesso sem sair da página
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  if (form && status) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled = true;
      btn.classList.add('opacity-60');
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        status.classList.remove('hidden', 'text-red-600', 'text-green-600');
        if (res.ok) {
          form.reset();
          status.textContent = '✅ Mensagem enviada com sucesso! Em breve entraremos em contato.';
          status.classList.add('text-green-600');
        } else {
          status.textContent = '❌ Não foi possível enviar. Tente novamente ou fale pelo WhatsApp.';
          status.classList.add('text-red-600');
        }
      } catch {
        status.classList.remove('hidden');
        status.textContent = '❌ Erro de conexão. Tente novamente ou fale pelo WhatsApp.';
        status.classList.add('text-red-600');
      } finally {
        btn.disabled = false;
        btn.classList.remove('opacity-60');
      }
    });
  }
</script>
