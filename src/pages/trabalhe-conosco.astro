---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { contact, site, formacoes } from '../data/site';

const formAction = contact.formspreeId ? `https://formspree.io/f/${contact.formspreeId}` : '';
const field =
  'mt-1.5 w-full rounded-lg border border-navy-200 bg-white px-4 py-2.5 text-navy-800 outline-none transition focus:border-magenta-400 focus:ring-2 focus:ring-magenta-200';
const perks = [
  { icon: 'users', title: 'Equipe interdisciplinar', text: 'Bombeiros, socorristas, enfermeiros, médicos, fisioterapeutas e engenheiros de segurança.' },
  { icon: 'map', title: 'Eventos em todo o Brasil', text: 'Shows, baladas, empresas, indústrias e grandes eventos.' },
  { icon: 'shield', title: 'Padrão Avanço', text: 'Operação padronizada, uniformizada e com foco em prevenção.' },
];
---
<Layout
  title="Trabalhe conosco"
  description="Faça parte da Equipe Avanço. Cadastre sua formação, região e experiência para atuar em eventos e empresas em todo o Brasil."
>
  <PageHeader
    eyebrow="Trabalhe conosco"
    title="Faça parte da Equipe Avanço"
    subtitle="Bombeiros civis, socorristas e profissionais da saúde e segurança: cadastre-se para atuar com a gente."
  />

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold text-navy-800">Por que a Avanço?</h2>
        <p class="mt-3 text-navy-500">
          Estamos sempre em busca de profissionais comprometidos com a vida e a prevenção.
          Preencha o cadastro e entraremos em contato quando houver uma oportunidade no seu perfil e região.
        </p>
        <ul class="mt-8 space-y-6">
          {perks.map((p) => (
            <li class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-navy-50 text-magenta-500">
                <Icon name={p.icon} class="h-6 w-6" />
              </div>
              <div>
                <h3 class="font-bold text-navy-800">{p.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-navy-500">{p.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-3">
        <div class="rounded-2xl border border-navy-100 bg-white p-7 shadow-sm sm:p-9">
          <h2 class="text-2xl font-bold text-navy-800">Cadastro de profissional</h2>
          <p class="mt-2 text-sm text-navy-500">Campos com * são obrigatórios.</p>

          {formAction ? (
            <form id="job-form" action={formAction} method="POST" class="mt-7 space-y-5">
              <input type="hidden" name="_subject" value={`Trabalhe conosco - novo cadastro pelo site - ${site.name}`} />
              <input type="hidden" name="origem" value="Trabalhe conosco" />
              <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

              <div>
                <label for="nome" class="block text-sm font-medium text-navy-700">Nome completo *</label>
                <input id="nome" name="nome" type="text" required class={field} />
              </div>

              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="telefone" class="block text-sm font-medium text-navy-700">WhatsApp / telefone *</label>
                  <input id="telefone" name="telefone" type="tel" required placeholder="(41) 99999-9999" class={field} />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-navy-700">E-mail *</label>
                  <input id="email" name="email" type="email" required class={field} />
                </div>
              </div>

              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="cidade" class="block text-sm font-medium text-navy-700">Cidade onde reside *</label>
                  <input id="cidade" name="cidade" type="text" required class={field} />
                </div>
                <div>
                  <label for="estado" class="block text-sm font-medium text-navy-700">Estado (UF) *</label>
                  <input id="estado" name="estado" type="text" required maxlength="2" placeholder="PR" class:list={[field, 'uppercase']} />
                </div>
              </div>

              <div>
                <label for="formacao" class="block text-sm font-medium text-navy-700">Formação principal *</label>
                <select id="formacao" name="formacao" required class={field}>
                  <option value="" disabled selected>Selecione</option>
                  {formacoes.map((f) => <option>{f}</option>)}
                </select>
              </div>

              <div>
                <label for="cursos" class="block text-sm font-medium text-navy-700">Cursos e certificações</label>
                <textarea id="cursos" name="cursos" rows="3" placeholder="Ex.: APH, NR-35, NR-33, salvamento aquático, registro profissional..." class={field}></textarea>
              </div>

              <div>
                <label for="experiencia" class="block text-sm font-medium text-navy-700">Experiências de trabalho *</label>
                <textarea id="experiencia" name="experiencia" rows="5" required placeholder="Conte onde já atuou, em quais tipos de evento ou empresa e por quanto tempo." class={field}></textarea>
              </div>

              <button type="submit"
                class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-magenta-500 px-7 py-3.5 font-semibold text-white shadow-lg shadow-magenta-500/25 transition-all hover:-translate-y-0.5 hover:bg-magenta-600 sm:w-auto">
                <Icon name="users" class="h-5 w-5" />
                Enviar cadastro
              </button>
              <p id="job-status" class="hidden text-sm"></p>
            </form>
          ) : (
            <p class="mt-7 rounded-xl border border-dashed border-navy-300 bg-navy-50 p-6 text-sm text-navy-600">
              Formulário em configuração. Envie seu currículo para
              <a href={`mailto:${contact.emails[0]}`} class="font-semibold text-magenta-600 hover:underline">{contact.emails[0]}</a>.
            </p>
          )}
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('job-form') as HTMLFormElement | null;
  const status = document.getElementById('job-status');
  if (form && status) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled = true;
      btn.classList.add('opacity-60');
      status.classList.remove('hidden', 'text-red-600', 'text-green-600');
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          form.reset();
          status.textContent = '✅ Cadastro enviado! Obrigado pelo interesse, entraremos em contato.';
          status.classList.add('text-green-600');
        } else {
          status.textContent = '❌ Não foi possível enviar. Tente novamente em instantes.';
          status.classList.add('text-red-600');
        }
      } catch {
        status.textContent = '❌ Erro de conexão. Tente novamente em instantes.';
        status.classList.add('text-red-600');
      } finally {
        btn.disabled = false;
        btn.classList.remove('opacity-60');
      }
    });
  }
</script>
