---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import { powerBi, contact, href } from '../data/site';

const wa = `https://wa.me/${contact.primaryWhatsapp}?text=${encodeURIComponent(contact.whatsappMessage)}`;
---
<Layout
  title="Área do cliente"
  description="Acompanhe indicadores e relatórios da Equipe Avanço. Área exclusiva do cliente."
>
  <PageHeader
    eyebrow="Área do cliente"
    title="Painéis e indicadores"
    subtitle="Acompanhe os dados e relatórios da sua operação."
  />

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 sm:py-20">
    {powerBi.embedUrl ? (
      <div class="overflow-hidden rounded-2xl border border-navy-100 shadow-sm">
        <div class="aspect-video w-full">
          <iframe
            title="Painel Power BI — Equipe Avanço"
            src={powerBi.embedUrl}
            class="h-full w-full"
            frameborder="0"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    ) : (
      <div class="mx-auto max-w-3xl rounded-2xl border border-dashed border-navy-300 bg-navy-50 p-10 text-center">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-white text-navy-600 shadow-sm">
          <Icon name="chart" class="h-8 w-8" />
        </div>
        <h2 class="mt-5 text-2xl font-bold text-navy-800">Painel em configuração</h2>
        <p class="mx-auto mt-3 max-w-xl text-navy-500">
          Em breve você poderá acompanhar aqui os indicadores e relatórios da operação.
          O painel público do Power BI será incorporado nesta página.
        </p>
      </div>
    )}

    <!-- Fase 2: login por cliente -->
    <div class="mx-auto mt-14 max-w-3xl rounded-2xl bg-brand-gradient p-8 text-white sm:p-10">
      <div class="flex items-start gap-4">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white/15">
          <Icon name="lock" class="h-6 w-6" />
        </div>
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-magenta-300">Em breve · Fase 2</span>
          <h2 class="mt-1 text-2xl font-bold">Acesso exclusivo por cliente</h2>
          <p class="mt-3 text-navy-100">
            Estamos preparando uma área logada onde cada cliente acessará, com segurança,
            apenas os seus próprios dados e relatórios personalizados.
          </p>
          <div class="mt-6">
            <Button href={wa} target="_blank" variant="primary">
              <Icon name="whatsapp" class="h-5 w-5" />
              Quero saber mais
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
