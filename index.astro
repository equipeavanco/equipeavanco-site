---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { site, contact, services, differentiators, mvv, portfolio, href } from '../data/site';

const wa = `https://wa.me/${contact.primaryWhatsapp}?text=${encodeURIComponent(contact.whatsappMessage)}`;
---
<Layout>
  <!-- ================= HERO ================= -->
  <section class="relative overflow-hidden bg-brand-gradient text-white">
    <div class="absolute inset-0 opacity-10" aria-hidden="true">
      <div class="absolute -right-20 -top-20 h-96 w-96 rounded-full bg-magenta-400 blur-3xl"></div>
      <div class="absolute -bottom-24 -left-24 h-96 w-96 rounded-full bg-navy-300 blur-3xl"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-32">
      <div class="max-w-3xl animate-fade-up">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider backdrop-blur">
          <Icon name="shield" class="h-4 w-4" />
          {site.descriptor}
        </span>
        <h1 class="mt-6 text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
          Prevenção que faz a <span class="text-magenta-300">diferença</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-navy-100">
          Soluções estratégicas e inovadoras em Segurança e Saúde Ocupacional:
          cobertura médica de eventos, treinamentos, consultoria e perícia técnica —
          com {contact.region.toLowerCase()}.
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <Button href={wa} target="_blank" variant="primary" size="lg">
            <Icon name="whatsapp" class="h-5 w-5" />
            Solicitar orçamento
          </Button>
          <Button href={href('/servicos')} variant="white" size="lg">
            Conhecer serviços
            <Icon name="arrow" class="h-5 w-5" />
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= DIFERENCIAIS ================= -->
  <section class="border-b border-navy-100 bg-navy-50/50">
    <div class="mx-auto grid max-w-7xl gap-6 px-4 py-12 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8">
      {differentiators.map((d) => (
        <div class="flex items-start gap-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white text-magenta-500 shadow-sm">
            <Icon name={d.icon} class="h-6 w-6" />
          </div>
          <div>
            <h3 class="font-bold text-navy-800">{d.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-navy-500">{d.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ================= SERVIÇOS ================= -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-semibold uppercase tracking-wider text-magenta-500">Nossos serviços</span>
      <h2 class="mt-3 text-3xl font-extrabold text-navy-800 sm:text-4xl">
        Tudo para ambientes mais seguros
      </h2>
      <p class="mt-4 text-navy-500">
        Da emergência à prevenção, uma estrutura completa para proteger pessoas e cumprir a legislação.
      </p>
    </div>
    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
  </section>

  <!-- ================= SOBRE (resumo) ================= -->
  <section class="bg-navy-50/50">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div>
        <span class="text-sm font-semibold uppercase tracking-wider text-magenta-500">Quem somos</span>
        <h2 class="mt-3 text-3xl font-extrabold text-navy-800 sm:text-4xl">
          Experiência que salva e previne
        </h2>
        <p class="mt-5 leading-relaxed text-navy-600">
          Fundada em {site.foundedYear}, a Equipe Avanço é especializada em assessoria
          preventiva, médica e pericial, com foco em Segurança e Saúde Ocupacional.
          Atuamos com agilidade, padronização e alta performance para garantir
          ambientes mais seguros em todo o Brasil.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button href={href('/sobre')} variant="secondary">
            Nossa história
            <Icon name="arrow" class="h-5 w-5" />
          </Button>
          <Button href={href('/contato')} variant="outline">Fale conosco</Button>
        </div>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="rounded-2xl bg-white p-6 shadow-sm">
          <Icon name="target" class="h-8 w-8 text-magenta-500" />
          <h3 class="mt-4 font-bold text-navy-800">Missão</h3>
          <p class="mt-2 text-sm leading-relaxed text-navy-500">{mvv.mission}</p>
        </div>
        <div class="rounded-2xl bg-white p-6 shadow-sm">
          <Icon name="bolt" class="h-8 w-8 text-magenta-500" />
          <h3 class="mt-4 font-bold text-navy-800">Visão</h3>
          <p class="mt-2 text-sm leading-relaxed text-navy-500">{mvv.vision}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PORTFÓLIO ================= -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-semibold uppercase tracking-wider text-magenta-500">Portfólio</span>
      <h2 class="mt-3 text-3xl font-extrabold text-navy-800 sm:text-4xl">
        Eventos que confiaram na Avanço
      </h2>
    </div>
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {portfolio.map((e) => (
        <div class="rounded-2xl border border-navy-100 bg-white p-6 transition-colors hover:border-magenta-200">
          <div class="flex items-center gap-2 text-magenta-500">
            <Icon name="check" class="h-5 w-5" />
            <h3 class="font-bold text-navy-800">{e.title}</h3>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-navy-500">{e.detail}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="bg-brand-gradient">
    <div class="mx-auto max-w-5xl px-4 py-16 text-center text-white sm:px-6 lg:px-8">
      <h2 class="text-3xl font-extrabold sm:text-4xl">Precisa de cobertura ou assessoria?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-navy-100">
        Entre em contato agora mesmo e receba um orçamento rápido, sob medida para a sua necessidade.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button href={wa} target="_blank" variant="primary" size="lg">
          <Icon name="whatsapp" class="h-5 w-5" />
          Falar no WhatsApp
        </Button>
        <Button href={href('/contato')} variant="white" size="lg">Enviar mensagem</Button>
      </div>
    </div>
  </section>
</Layout>
